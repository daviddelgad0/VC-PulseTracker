# Neon Postgres connection strings (Storage tab in Vercel dashboard -> your DB -> .env.local / Quickstart)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# SEC EDGAR requires a descriptive User-Agent with contact info on every request.
SEC_EDGAR_USER_AGENT="VC Pulse Tracker (your-email@example.com)"

# Optional: raises GitHub's unauthenticated API rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=

# Optional: required for the Product Hunt source.
PRODUCTHUNT_API_TOKEN=

# Required for LLM-assisted fund-feed discovery (dashboard/pages/3_Manage_Watchlist.py).
# Get one at console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
